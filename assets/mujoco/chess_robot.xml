      <geom type="cylinder" size="0.055 0.035" material="robot_mat"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.16" size="0.025" material="robot_mat"/>
